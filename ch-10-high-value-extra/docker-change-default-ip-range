Create file - /etc/docker/daemon.json 
with your custom ip range
 
{
        "bip": "192.168.10.1/24",
        "default-address-pools": [
                {
                        "base": "192.168.10.0/24",
                        "size": 26
                }
        ]
}


## save and exit
systemctl daemon-reload
systemctl restart docker
  
